ErrorDocument 400 /index.html
ErrorDocument 401 /index.html
ErrorDocument 403 /index.html
ErrorDocument 404 /index.html
ErrorDocument 500 /index.html

RewriteEngine On
RewriteBase /

# URLs sem extensão apontam para o .html correspondente (/pgr -> /pgr.html).
# Antes existia um catch-all que devolvia a index com status 200 para
# QUALQUER caminho inexistente: o Google indexava URL inventada como página
# válida (soft 404). Agora, o que não existe cai no ErrorDocument, que
# responde 404 de verdade mostrando a home.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# ---- Blog ----
# Os posts moram em /blog/<slug>/index.html, então /blog/<slug> vira
# /blog/<slug>/ pelo DirectorySlash do Apache e o index é servido sozinho.
# Aqui só fechamos as pastas de trabalho do CMS (template e build), que
# não devem ser servidas nem indexadas.
RewriteRule ^blog/_(build|templates)/ - [R=404,L]

# O antigo blog vivia em blog.bevart.com.br. Se um dia o subdomínio for
# apontado para este mesmo host, descomente as duas linhas abaixo para
# redirecionar tudo que chegar por lá para a pasta /blog (301 preserva o
# ranking que o subdomínio já tem).
# RewriteCond %{HTTP_HOST} ^blog[.]bevart[.]com[.]br$ [NC]
# RewriteRule ^(.*)$ https://bevart.com.br/blog/$1 [R=301,L]


# Cache longo para estáticos (o HTML continua sem cache agressivo)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.json$">
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type"
  </FilesMatch>
</IfModule>
