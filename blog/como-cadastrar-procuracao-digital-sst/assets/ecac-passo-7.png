                  height="780" loading="lazy" decoding="async">
                <span class="bv-shot-hint">Clique para ampliar</span>
              </button>
            </article>

            <!-- Ergonomia AEP -> AET -->
            <article class="bv-deep" data-aos="fade-up">
              <div class="bv-deep-text">
                <span class="bv-pill">Ergonomia · NR-17</span>
                <h3 class="bv-h3 mt-4 text-2xl">Do AEP à AET dentro da mesma plataforma</h3>
                <p class="mt-4 text-ink-700/75 leading-relaxed">
                  Comece pela Avaliação Ergonômica Preliminar e evolua para a Análise Ergonômica do Trabalho quando o
                  risco exigir. Termômetro ergonômico, radar de percepção dos trabalhadores (OSHA / Nórdico) e mapa
                  anatômico de queixas, tudo ligado ao inventário e aos planos de ação.
                </p>
                <div class="grid sm:grid-cols-3 gap-3 mt-6">
                  <div class="bv-mini bv-mini--blue">
                    <p class="bv-mini-title">Física</p>
                    <p class="bv-mini-text">Postura, esforço, cargas, repetitividade</p>
                  </div>
                  <div class="bv-mini bv-mini--teal">
                    <p class="bv-mini-title">Organizacional</p>
                    <p class="bv-mini-text">Pausas, ritmo, turnos, metas</p>
                  </div>
                  <div class="bv-mini bv-mini--violet">
                    <p class="bv-mini-title">Cognitiva</p>
                    <p class="bv-mini-text">Sobrecarga mental, estresse, atenção</p>
                  </div>
                </div>
              </div>
              <button type="button" class="bv-shot" aria-label="Ampliar tela de análise ergonômica"
                @click="shot='assets/telas/analise_ergonomica_bevart.webp'; alt='Dashboard de análise ergonômica do Bevart'">
                <img src="assets/telas/analise_ergonomica_bevart.webp"
                  alt="Dashboard de análise ergonômica do Bevart com termômetro ergonômico e mapa anatômico"
                  width="1852" height="1041" loading="lazy" decoding="async">
                <span class="bv-shot-hint">Clique para ampliar</span>
              </button>
            </article>

            <!-- Indicadores -->
            <article class="bv-deep bv-deep--reverse" data-aos="fade-up">
              <div class="bv-deep-text">
                <span class="bv-pill">Indicadores · CAT e atestados</span>
                <h3 class="bv-h3 mt-4 text-2xl">O que aconteceu, por que aconteceu e o que foi feito</h3>
                <p class="mt-4 text-ink-700/75 leading-relaxed">
