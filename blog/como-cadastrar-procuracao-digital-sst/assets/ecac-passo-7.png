            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        <!-- template x-if: sem isso o img nasceria com src vazio e o
             navegador dispararia uma requisição abortada no carregamento. -->
        <template x-if="shot">
