<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bevart - Plataforma de gestão de SST para consultorias e profissionais</title>
  <meta name="description"
    content="Do inventário de riscos ao eSocial em um só fluxo: PGR, PCMSO, LTCAT, exames, treinamentos, EPI, psicossocial e AEP/AET. Crie sua conta e teste 5 dias, sem cartão.">
  <link rel="canonical" href="https://bevart.com.br/">
  <meta name="robots" content="index, follow, max-image-preview:large">
  <meta name="theme-color" content="#2563eb">

  <!-- Open Graph / Twitter -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Bevart">
  <meta property="og:locale" content="pt_BR">
  <meta property="og:url" content="https://bevart.com.br/">
  <meta property="og:title" content="Bevart  do risco mapeado ao eSocial entregue">
  <meta property="og:description"
    content="Inventário de riscos, documentos, exames, treinamentos, EPI e eventos do eSocial em uma única plataforma de SST.">
  <meta property="og:image" content="https://bevart.com.br/assets/img/tela_sistema_sst_bevart.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Bevart  do risco mapeado ao eSocial entregue">
  <meta name="twitter:description"
    content="Inventário de riscos, documentos, exames, treinamentos, EPI e eventos do eSocial em uma única plataforma de SST.">
  <meta name="twitter:image" content="https://bevart.com.br/assets/img/tela_sistema_sst_bevart.png">

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-17992875515"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'AW-17992875515');
    gtag('config', 'G-Z0RJMZR8R2');
  </script>
  <!-- Conversões do Google Ads (mesmos rótulos das páginas internas) -->
  <script>
    function gtag_report_conversion(url) {
      if (typeof gtag !== 'function') {
        if (typeof url !== 'undefined') { window.location = url; }
        return false;
      }
      var callback = function () {
        if (typeof url !== 'undefined') { window.location = url; }
      };
      gtag('event', 'conversion', {
        'send_to': 'AW-17992875515/YUXSCN2X8IQcEPv71YND',
        'event_callback': callback
      });
      return false;
    }

    function gtag_report_whatsapp_conversion() {
      if (typeof gtag === 'function') {
        gtag('event', 'conversion', {
          'send_to': 'AW-17992875515/nPR2CPXJyoUcEPv71YND',
          'value': 1.0,
          'currency': 'BRL'
        });
      }
    }

    document.addEventListener('click', function (e) {
      var cadastro = e.target.closest('a[href*="profissionais.bevart.com.br/app/src/login/views/login"]');
      if (cadastro) {
        // Links que abrem em nova aba seguem sozinhos: só registramos a conversão.
        if (cadastro.target === '_blank') {
          gtag_report_conversion();
        } else {
          e.preventDefault();
          gtag_report_conversion(cadastro.href);
        }
      }

      if (e.target.closest('a[href*="wa.me"], a[href*="whatsapp.com"]')) {
        gtag_report_whatsapp_conversion();
      }
    });
  </script>

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
          colors: {
            primary: { 50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe', 300: '#93c5fd', 400: '#60a5fa', 500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8', 800: '#1e40af', 900: '#1e3a8a' },
            accent: { 50: '#ecfdf5', 100: '#d1fae5', 200: '#a7f3d0', 400: '#34d399', 500: '#10b981', 600: '#059669', 700: '#047857' },
            ink: { 700: '#334155', 800: '#1e293b', 900: '#0f172a', 950: '#080d17' },
            whatsapp: '#25D366',
            instagram: '#E1306C',
          },
          boxShadow: {
            card: '0 1px 2px 0 rgba(16,24,40,.04), 0 1px 3px 0 rgba(16,24,40,.06)',
            lift: '0 16px 40px -16px rgba(16,24,40,.22)',
            product: '0 48px 90px -40px rgba(15,23,42,.42), 0 0 0 1px rgba(15,23,42,.06)',
          },
          borderRadius: { '4xl': '1.75rem' },
        }
      }
    }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
